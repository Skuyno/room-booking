# Скопируй в .env и подставь свои значения: cp .env.example .env

# HTTP-порт сервиса.
HTTP_PORT=8080

# DSN PostgreSQL. Формат: postgres://user:password@host:port/dbname?sslmode=disable
# При запуске через docker-compose host = db.
DB_DSN=postgres://booking:booking@db:5432/booking?sslmode=disable

# Симметричный ключ для подписи JWT (HS256). В проде — длинная случайная строка.
JWT_SECRET=please-change-this-in-production
